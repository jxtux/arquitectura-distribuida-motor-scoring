# Motor Scoring Distribuido V3.6.6
# SOLO configuracion NO sensible. Copiar como .env.
# Los secretos se generan en secrets/bootstrap.env (archivo ignorado por Git)
# y luego se almacenan/consumen desde HashiCorp Vault.

KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Puertos publicados en el host. Los puertos internos Docker no cambian.
# Si otra version del proyecto ocupa uno, detengala o cambie solo el puerto host.
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9092
SCHEMA_REGISTRY_HOST_PORT=8088
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
VAULT_HOST_PORT=8200
KONG_HTTPS_HOST_PORT=8443
KONG_ADMIN_HOST_PORT=8001
FRONTEND_HOST_PORT=4200
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133
ALLOY_HOST_PORT=12345

IAM_ADMIN_EMAIL=admin@finanscore.local
IAM_ADMIN_DISPLAY_NAME=Administrador Demo
IAM_MAIL_FROM=no-reply@finanscore.local
IAM_FRONTEND_SOCIAL_CALLBACK=http://localhost:4200/auth/social-callback
IAM_REFRESH_COOKIE_SECURE=true
IAM_REFRESH_COOKIE_SAME_SITE=None

# Identificadores publicos OAuth. Los client secrets NO van aqui.
GOOGLE_CLIENT_ID=not-configured
TIKTOK_CLIENT_KEY=not-configured
TIKTOK_REDIRECT_URI=https://replace-me.ngrok-free.app/api/v1/auth/social/tiktok/callback

# Cuenta remitente. El App Password NO va aqui.
GMAIL_USERNAME=

MINIO_ROOT_USER=minioadmin
GRAFANA_ADMIN_USER=admin
GRAFANA_PUBLIC_URL=http://localhost:3000
QUERY_CACHE_TTL_SECONDS=60
